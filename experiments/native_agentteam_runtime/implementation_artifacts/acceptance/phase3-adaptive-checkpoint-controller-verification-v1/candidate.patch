@@ -1,7 +1,9 @@
 import json
+from types import SimpleNamespace
 
 from dvc.cli import parse_args
 from dvc.commands.ls import CmdList
+from dvc.repo.ls import _ls
 
 
 def _test_cli(mocker, *args):
@@ -31,6 +33,39 @@ def test_list_recursive(mocker):
     )
 
 
+def test_list_recursive_reuses_walk_details(mocker):
+    fs = mocker.MagicMock()
+    fs.from_os_path.return_value = "root"
+    fs.info.return_value = {"name": "root"}
+    fs.path.join.side_effect = lambda *parts: "/".join(parts)
+    fs.path.relparts.return_value = ("file",)
+    fs.walk.return_value = [
+        (
+            "root",
+            {},
+            {
+                "file": {
+                    "name": "root/file",
+                    "type": "file",
+                    "dvc_info": {"isout": True},
+                }
+            },
+        )
+    ]
+
+    assert _ls(
+        SimpleNamespace(dvcfs=fs),
+        "root",
+        recursive=True,
+        dvc_only=True,
+    ) == {"file": {"isout": True, "isdir": False, "isexec": False}}
+    fs.walk.assert_called_once_with(
+        "root", dvcfiles=True, dvc_only=True, detail=True
+    )
+    fs.info.assert_called_once_with("root")
+    fs.isdvc.assert_not_called()
+
+
 def test_list_git_ssh_rev(mocker):
     url = "git@github.com:repo"
     m = _test_cli(mocker, url, "--rev", "123")
