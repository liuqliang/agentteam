  "taskpack": {
    "taskpack_id": "phase2-experiment-harness-implementation",
    "goal_kind": "implementation",
    "milestone": "research-phase-2",
    "goal": "Implement the protocol-bound three-mode experiment harness, isolated snapshots and evaluation, global safe-boundary budgets, operator ledger, sealed result bundles, and deterministic calibration required to close P0 experiment readiness.",
    "overall_risk": "L2",
    "integration_policy": "verified implementation baseline followed by operator review and candidate-release handoff to a separately frozen promotion taskpack"
  },
  "contract": {
    "authority_model": "immutable_protocols_run_manifests_request_bindings_append_only_events_ledgers_sealed_results_and_rebuildable_projection",
    "protocol_schema": "experiment_protocol.v1",
    "run_manifest_schema": "experiment_run_manifest.v2",
    "legacy_manifest_policy": "validation_only_not_executable",
    "run_identity": "protocol_digest_mode_repetition_stable_request_key",
    "duplicate_request_policy": "return_existing_run_before_provider_launch",
    "controller_writer_policy": "single_writer_lease",
    "mode_inventory": [
      "single_codex",
      "agentteam_direct",
      "agentteam_full"
    ],
    "equal_input_policy": "same_commit_tree_goal_constraints_acceptance_environment_model_reasoning_seed_budgets_and_operator_limits",
    "direct_taskpack_policy": "preauthored_digest_bound_cost_reported_separately_and_unavailable_to_full_mode",
    "initial_model_policy": "same_model_and_reasoning_for_all_modes_and_roles",
    "max_inflight_model_invocations": 1,
    "provider_lane_scope": "protocol_global_cross_run_single_writer_lease",
    "mode_order_policy": "seeded_permutation_with_counterbalanced_rotation_across_repetitions",
    "single_codex_context_policy": "original_goal_constraints_acceptance_text_and_direct_browsing_of_sanitized_repository_only",
    "repository_policy": "new_sanitized_object_store_with_exact_commit_no_remote_no_alternate_no_extra_refs",
    "blind_gold_policy": "bwrap_namespace_with_evaluator_only_canary_and_post_run_leak_scan",
    "acceptance_policy": "trusted_post_model_argv_evaluator_with_bound_environment_timeout_and_digest",
    "token_budget_policy": "provider_terminal_totals_no_new_invocation_after_exhaustion_visible_one_invocation_overshoot",
    "scored_budget_extension_policy": "forbidden_new_unscored_protocol_lineage_required",
    "budget_boundaries": [
      "pre_provider_launch",
      "post_invocation_terminal",
      "pre_integration",
      "post_integration"
    ],
    "operator_action_classes": [
      "expected_operator_action",
      "corrective_intervention",
      "decision_escalation"
    ],
    "result_policy": "versioned_recovery_snapshots_separate_from_fsync_and_atomic_directory_rename_create_if_absent_sealed_terminal_bundle",
    "failed_run_policy": "failed_interrupted_and_budget_stopped_evidence_is_retained",
    "artifact_byte_policy": "authoritative_run_artifacts_excluding_git_objects_caches_projection_db_and_raw_spools",
    "projection_policy": "sqlite_is_rebuildable_and_never_authoritative",
    "readiness_order": "deterministic_calibration_then_promotion_and_pilot_guard_then_live_calibration",
    "runtime_bootstrap_policy": "implementation_taskpack_completes_then_operator_reviews_and_installs_candidate_release_before_freezing_promotion_taskpack",
    "calibration_gate": "one_hundred_percent_counted_lifecycle_and_token_coverage_with_projection_rebuild_equality",
    "write_scope_cardinality_policy": {
      "default_max_entries": 5,
      "exact_path_exceptions": {
        "P2-01": 6,
        "P2-02B": 7,
        "P2-07B": 6
      },
      "exception_scope_rule": "production_and_schema_paths_exact_test_and_fixture_directory_scope_allowed",
