{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/phase3_routing_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "phase3_routing_manifest.v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset", "metadata", "gold_visibility", "allowlisted_fields"],
      "properties": {
        "dataset": {
          "type": "object", "additionalProperties": false,
          "required": ["benchmark", "source_repository", "source_commit", "artifact_path", "artifact_sha256", "split", "row_count"],
          "properties": {
            "benchmark": {"const": "swe_evo"}, "source_repository": {"const": "https://github.com/SWE-EVO/SWE-EVO.git"},
            "source_commit": {"const": "9b83d5af943ba7a17567336f5b18239f73960219"},
            "artifact_path": {"const": "hf_out/hf_dataset/test/data-00000-of-00001.arrow"}, "artifact_sha256": {"const": "74e7c63160ada4ceba71d5d89a9bb7c9794f4574b384458d546eb65cdb730520"},
            "split": {"const": "test"}, "row_count": {"const": 48}
          }
        },
        "metadata": {
          "type": "object", "additionalProperties": false,
          "required": ["schema_version", "benchmark", "metadata_revision", "instances"],
          "properties": {
            "schema_version": {"const": "swe_evo_metadata.v1"}, "benchmark": {"const": "swe_evo"},
            "metadata_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
            "instances": {"type": "array", "minItems": 48, "maxItems": 48, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["instance_id", "repository", "complexity_stratum", "language", "tags"],
              "properties": {
                "instance_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
                "repository": {"type": "string", "minLength": 1},
                "complexity_stratum": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
                "language": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
                "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"}}
              }
            }}
          }
        },
        "gold_visibility": {"const": "evaluator_only"},
        "allowlisted_fields": {
          "type": "array",
          "prefixItems": [
            {"const": "instance_id"},
            {"const": "repository"},
            {"const": "complexity_stratum"},
            {"const": "language"},
            {"const": "tags"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      }
    }
  }
}
