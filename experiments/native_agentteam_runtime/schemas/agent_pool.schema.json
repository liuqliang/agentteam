{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/native_runtime/agent_pool.schema.json",
  "title": "AgentTeam Native Runtime Agent Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["pool_id", "scheduler_agent_id", "updated_at", "agents"],
  "properties": {
    "pool_id": {
      "type": "string",
      "minLength": 1
    },
    "scheduler_agent_id": {
      "type": "string",
      "pattern": "^agent-[a-z0-9][a-z0-9_-]*$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "role_runtime_profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["adapter"],
        "properties": {
          "adapter": {
            "type": "string",
            "enum": ["fake", "shell", "codex"]
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "reasoning_profile": {
            "type": "string",
            "enum": ["none", "low", "medium", "high", "xhigh", "max"]
          },
          "sandbox": {
            "type": "string",
            "minLength": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "fallback_worktree_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "model_routing_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "policy_id",
        "mode",
        "retry_escalation"
      ],
      "properties": {
        "schema_version": {
          "const": "agentteam_model_routing.v1"
        },
        "policy_id": {
          "const": "gpt-5.6-cost-aware.v1"
        },
        "mode": {
          "enum": ["adaptive", "fixed"]
        },
        "retry_escalation": {
          "type": "boolean"
        },
        "fixed_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "reasoning_profile"],
          "properties": {
            "model": {"type": "string", "minLength": 1},
            "reasoning_profile": {
              "enum": ["none", "low", "medium", "high", "xhigh", "max"]
            }
          }
        }
      }
    },
    "role_prompt_contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role_summary": {
            "type": "string",
            "minLength": 1
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "required_output_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "context_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "include_repo_map_references": {
            "type": "boolean"
          }
        }
      }
    },
    "role_context_packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "context_artifacts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "excerpt_chars": {
            "type": "integer",
            "minimum": 1
          },
          "context_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "agent_state.schema.json"
      },
      "minItems": 1
    }
  }
}
