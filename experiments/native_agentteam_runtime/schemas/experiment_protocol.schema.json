{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/experiment_protocol.schema.json",
  "title": "AgentTeam Phase 2 immutable experiment protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "instance_id",
    "repository",
    "goal",
    "acceptance",
    "modes",
    "mode_order",
    "mode_instructions",
    "repetition_policy",
    "environment",
    "seed",
    "scored",
    "blind_gold",
    "budgets",
    "operator_limits",
    "evaluator",
    "direct_taskpack",
    "usage_contract_version"
  ],
  "properties": {
    "schema_version": {
      "const": "experiment_protocol.v1"
    },
    "experiment_id": {
      "$ref": "#/$defs/safe_id"
    },
    "instance_id": {
      "$ref": "#/$defs/safe_id"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "constraints"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "timeout_seconds"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/argv"
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "modes": {
      "type": "array",
      "prefixItems": [
        {
          "const": "single_codex"
        },
        {
          "const": "agentteam_direct"
        },
        {
          "const": "agentteam_full"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "mode_order": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/mode"
      },
      "allOf": [
        {
          "contains": {
            "const": "single_codex"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "agentteam_direct"
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "const": "agentteam_full"
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "mode_instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_codex",
        "agentteam_direct",
        "agentteam_full"
      ],
      "properties": {
        "single_codex": {
          "$ref": "#/$defs/instructions"
        },
        "agentteam_direct": {
          "$ref": "#/$defs/instructions"
        },
        "agentteam_full": {
          "$ref": "#/$defs/instructions"
        }
      }
    },
    "repetition_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "order_strategy"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "order_strategy": {
          "const": "seeded_counterbalanced_rotation"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": {
        "tool_output_token_limit": [
          "web_search_policy"
        ],
        "web_search_policy": [
          "tool_output_token_limit"
        ],
        "model_auto_compact_token_limit": [
          "tool_output_token_limit",
          "web_search_policy",
          "tool_call_soft_limit",
          "tool_call_hard_limit",
          "tool_budget_policy"
        ],
        "tool_call_soft_limit": [
          "tool_output_token_limit",
          "web_search_policy",
          "model_auto_compact_token_limit",
          "tool_call_hard_limit",
          "tool_budget_policy"
        ],
        "tool_call_hard_limit": [
          "tool_output_token_limit",
          "web_search_policy",
          "model_auto_compact_token_limit",
          "tool_call_soft_limit",
          "tool_budget_policy"
        ],
        "tool_budget_policy": [
          "tool_output_token_limit",
          "web_search_policy",
          "model_auto_compact_token_limit",
          "tool_call_soft_limit",
          "tool_call_hard_limit"
        ]
      },
      "required": [
        "backend",
        "codex_cli_version",
        "model",
        "reasoning_profile",
        "service_configuration_sha256",
        "sandbox_policy",
        "permission_policy",
        "network_policy",
        "tool_allowlist",
        "host_class",
        "cpu_limit",
        "memory_limit_bytes",
        "dependency_cache_policy",
        "max_inflight_model_invocations"
      ],
      "properties": {
        "backend": {
          "const": "codex"
        },
        "codex_cli_version": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_profile": {
          "type": "string",
          "minLength": 1
        },
        "service_configuration_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sandbox_policy": {
          "type": "string",
          "minLength": 1
        },
        "permission_policy": {
          "type": "string",
          "minLength": 1
        },
        "network_policy": {
          "enum": [
            "disabled",
            "provider_access"
          ]
        },
        "tool_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tool_output_token_limit": {
          "type": "integer",
          "minimum": 256,
          "maximum": 100000
        },
        "web_search_policy": {
          "const": "disabled"
        },
        "model_auto_compact_token_limit": {
          "type": "integer",
          "minimum": 8192,
          "maximum": 1000000
        },
        "tool_call_soft_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "tool_call_hard_limit": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000
        },
        "tool_budget_policy": {
          "const": "codex_pre_tool_budget.v1"
        },
        "host_class": {
          "type": "string",
          "minLength": 1
        },
        "cpu_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "memory_limit_bytes": {
          "type": "integer",
          "minimum": 67108864
        },
        "dependency_cache_policy": {
          "type": "string",
          "minLength": 1
        },
        "max_inflight_model_invocations": {
          "const": 1
        }
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "scored": {
      "type": "boolean"
    },
    "blind_gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "const": "unavailable_to_runtime"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_total_tokens",
        "max_wall_time_seconds",
        "soft_warning_ratio",
        "stop_boundaries"
      ],
      "properties": {
        "max_total_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_wall_time_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "soft_warning_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "stop_boundaries": {
          "type": "array",
          "prefixItems": [
            {
              "const": "pre_provider_launch"
            },
            {
              "const": "post_invocation_terminal"
            },
            {
              "const": "pre_integration"
            },
            {
              "const": "post_integration"
            }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "operator_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_operator_action",
        "corrective_intervention",
        "decision_escalation"
      ],
      "properties": {
        "expected_operator_action": {
          "type": "integer",
          "minimum": 0
        },
        "corrective_intervention": {
          "type": "integer",
          "minimum": 0
        },
        "decision_escalation": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "artifact_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_patch_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submission",
            "hidden_test_composition",
            "candidate_invalid_outcome",
            "conflict_outcome",
            "score_rejected_candidate"
          ],
          "properties": {
            "submission": {
              "const": "complete_candidate_patch"
            },
            "hidden_test_composition": {
              "const": "require_clean_git_apply"
            },
            "candidate_invalid_outcome": {
              "const": "candidate_patch_invalid"
            },
            "conflict_outcome": {
              "const": "evaluator_patch_conflict"
            },
            "score_rejected_candidate": {
              "const": false
            }
          }
        }
      }
    },
    "direct_taskpack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "cost_reported_separately",
        "available_to_full_mode"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cost_reported_separately": {
          "const": true
        },
        "available_to_full_mode": {
          "const": false
        }
      }
    },
    "usage_contract_version": {
      "const": "model_invocation_usage.v1"
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^/"
        }
      ],
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mode": {
      "enum": [
        "single_codex",
        "agentteam_direct",
        "agentteam_full"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "commit",
        "tree",
        "git_object_format"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "tree": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "git_object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha1"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "commit": {
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree": {
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha256"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "commit": {
                "pattern": "^[0-9a-f]{64}$"
              },
              "tree": {
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "safe_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
