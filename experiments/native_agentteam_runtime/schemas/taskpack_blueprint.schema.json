{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/taskpack_blueprint.schema.json",
  "title": "AgentTeam Taskpack Blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blueprint_id",
    "source_plan",
    "taskpack",
    "approval",
    "agents",
    "verification",
    "policy",
    "tasks"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "agentteam_taskpack_blueprint.v1"
    },
    "blueprint_id": {
      "$ref": "#/$defs/taskpack_id"
    },
    "source_plan": {
      "$ref": "#/$defs/repository_path"
    },
    "research_authority": {
      "$ref": "#/$defs/repository_path"
    },
    "taskpack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskpack_id",
        "goal_kind",
        "goal",
        "overall_risk"
      ],
      "properties": {
        "taskpack_id": {
          "$ref": "#/$defs/taskpack_id"
        },
        "goal_kind": {
          "enum": [
            "implementation",
            "optimization",
            "audit"
          ]
        },
        "milestone": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "$ref": "#/$defs/non_empty_string"
        },
        "original_goal": {
          "$ref": "#/$defs/non_empty_string"
        },
        "overall_risk": {
          "$ref": "#/$defs/risk"
        },
        "integration_policy": {
          "$ref": "#/$defs/non_empty_string"
        }
      }
    },
    "contract": {
      "type": "object"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_path",
        "schema_path",
        "required_decision",
        "digest_bindings"
      ],
      "properties": {
        "record_path": {
          "$ref": "#/$defs/repository_path"
        },
        "schema_path": {
          "$ref": "#/$defs/repository_path"
        },
        "required_decision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "git_object_format_required": {
          "type": "boolean"
        },
        "runtime_release_binding_required": {
          "type": "boolean"
        },
        "digest_bindings": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "source_plan",
              "blueprint",
              "research_authority",
              "review_schema",
              "stage_vocabulary",
              "contract"
            ]
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "role",
          "runtime_profile"
        ],
        "properties": {
          "agent_id": {
            "$ref": "#/$defs/non_empty_string"
          },
          "role": {
            "$ref": "#/$defs/non_empty_string"
          },
          "runtime_profile": {
            "$ref": "#/$defs/runtime_profile"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "success_criteria": {
          "$ref": "#/$defs/non_empty_string_array"
        }
      }
    },
    "policy": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "post_backlog_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/post_backlog_gate"
      }
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "non_empty_string_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/non_empty_string"
      }
    },
    "string_array": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "taskpack_id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$"
    },
    "repository_path": {
      "$ref": "#/$defs/non_empty_string"
    },
    "risk": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3"
      ]
    },
    "runtime_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "fake",
            "codex"
          ]
        },
        "model": {
          "$ref": "#/$defs/non_empty_string"
        },
        "sandbox": {
          "$ref": "#/$defs/non_empty_string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "objective",
        "goal_alignment",
        "work_type",
        "required_role",
        "backlog_status",
        "risk_target",
        "depends_on",
        "blockers",
        "read_scope",
        "write_scope",
        "required_deliverables",
        "acceptance_criteria",
        "stop_condition",
        "input_artifacts"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "milestone_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "objective": {
          "$ref": "#/$defs/non_empty_string"
        },
        "goal_alignment": {
          "$ref": "#/$defs/non_empty_string"
        },
        "work_type": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_role": {
          "$ref": "#/$defs/non_empty_string"
        },
        "backlog_status": {
          "$ref": "#/$defs/non_empty_string"
        },
        "risk_target": {
          "$ref": "#/$defs/risk"
        },
        "depends_on": {
          "$ref": "#/$defs/string_array"
        },
        "blockers": {
          "$ref": "#/$defs/string_array"
        },
        "read_scope": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "write_scope": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "required_deliverables": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "acceptance_criteria": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "stop_condition": {
          "$ref": "#/$defs/non_empty_string"
        },
        "input_artifacts": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "expected_output_artifacts": {
          "$ref": "#/$defs/string_array"
        },
        "evidence_paths": {
          "$ref": "#/$defs/string_array"
        }
      }
    },
    "post_backlog_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "depends_on",
        "executor",
        "evidence_artifact",
        "evidence_schema",
        "required_status_field",
        "required_status_value"
      ],
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/non_empty_string"
        },
        "depends_on": {
          "$ref": "#/$defs/non_empty_string_array"
        },
        "executor": {
          "$ref": "#/$defs/non_empty_string"
        },
        "operator_authorization_required": {
          "type": "boolean"
        },
        "operator_review_required": {
          "type": "boolean"
        },
        "operator_approval_schema": {
          "$ref": "#/$defs/repository_path"
        },
        "operator_approval_required_decision": {
          "$ref": "#/$defs/non_empty_string"
        },
        "evidence_run_registration_required": {
          "type": "boolean"
        },
        "evidence_artifact": {
          "$ref": "#/$defs/repository_path"
        },
        "evidence_schema": {
          "$ref": "#/$defs/repository_path"
        },
        "required_status_field": {
          "$ref": "#/$defs/non_empty_string"
        },
        "required_status_value": {
          "$ref": "#/$defs/non_empty_string"
        },
        "commit_field": {
          "$ref": "#/$defs/non_empty_string"
        },
        "integration_head_relation": {
          "enum": [
            "equals",
            "ancestor_of"
          ]
        },
        "source_plan_section": {
          "$ref": "#/$defs/non_empty_string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator_review_required": {
                "const": true
              }
            },
            "required": [
              "operator_review_required"
            ]
          },
          "then": {
            "required": [
              "operator_approval_schema",
              "operator_approval_required_decision"
            ]
          }
        }
      ]
    }
  }
}
