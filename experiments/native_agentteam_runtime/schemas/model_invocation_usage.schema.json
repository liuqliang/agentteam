{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/model_invocation_usage.schema.json",
  "title": "AgentTeam terminal model invocation usage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "usage_schema_version",
    "usage_event_id",
    "invocation_id",
    "project",
    "run_id",
    "pursue_id",
    "round_index",
    "taskpack_id",
    "implementation_run_id",
    "gate_epoch",
    "task_id",
    "attempt_id",
    "runtime_execution_session_id",
    "provider_session_id",
    "provider_predecessor_invocation_id",
    "provider_turn_id",
    "provider_predecessor_turn_id",
    "lifecycle_owner_token",
    "terminal_writer",
    "agent_id",
    "role",
    "usage_stage",
    "backend",
    "model",
    "coverage_class",
    "terminal_status",
    "usage_status",
    "usage_source",
    "provider_usage_scope",
    "accounting_method",
    "provider_usage_snapshot",
    "unavailable_reason",
    "input_tokens",
    "cached_input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "total_tokens",
    "started_at",
    "finished_at",
    "wall_time_seconds",
    "source_artifact_path"
  ],
  "properties": {
    "usage_schema_version": {
      "const": "model_invocation_usage.v1"
    },
    "usage_event_id": {
      "type": "string",
      "pattern": "^USAGE-[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "invocation_id": {
      "$ref": "#/$defs/invocationId"
    },
    "start_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "project": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "pursue_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "round_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "taskpack_id": {
      "$ref": "#/$defs/identifier"
    },
    "decision_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^DEC-[A-Za-z0-9][A-Za-z0-9_.:-]*$"}
      ]
    },
    "implementation_run_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "gate_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "task_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "attempt_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "runtime_execution_session_id": {
      "$ref": "#/$defs/identifier"
    },
    "provider_session_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "provider_predecessor_invocation_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/invocationId"
        }
      ]
    },
    "provider_turn_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "provider_predecessor_turn_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "lifecycle_owner_token": {
      "$ref": "#/$defs/identifier"
    },
    "terminal_writer": {
      "enum": [
        "worker",
        "taskpack_author",
        "runtime_diagnostic_controller",
        "development_smoke_controller",
        "recovery_controller",
        "acceptance_controller"
      ]
    },
    "agent_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "role": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "usage_stage": {
      "$ref": "#/$defs/usageStage"
    },
    "backend": {
      "$ref": "#/$defs/identifier"
    },
    "model": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "reasoning_profile": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "model_routing": {
      "type": "object"
    },
    "tool_budget_routing": {
      "type": "object"
    },
    "experiment_run_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "experiment_mode": {
      "enum": [
        "single_codex",
        "agentteam_direct",
        "agentteam_full"
      ]
    },
    "experiment_protocol_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_run_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "coverage_class": {
      "enum": [
        "supported_model_invocation",
        "not_applicable_adapter"
      ]
    },
    "experiment_sandbox_policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "experiment_sandbox_reference_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "terminal_status": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "timed_out",
        "launch_failed",
        "missing_result",
        "invalid_result",
        "recovered_orphan"
      ]
    },
    "usage_status": {
      "enum": [
        "reported",
        "partial",
        "unavailable",
        "not_applicable"
      ]
    },
    "usage_source": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "provider_usage_scope": {
      "enum": [
        "invocation",
        "session_cumulative",
        "unknown"
      ]
    },
    "accounting_method": {
      "enum": [
        "provider_reported",
        "session_delta",
        "not_applicable",
        "unavailable"
      ]
    },
    "provider_usage_snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/tokenSnapshot"
        }
      ]
    },
    "unavailable_reason": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "input_tokens": {
      "$ref": "#/$defs/nullableToken"
    },
    "cached_input_tokens": {
      "$ref": "#/$defs/nullableToken"
    },
    "output_tokens": {
      "$ref": "#/$defs/nullableToken"
    },
    "reasoning_tokens": {
      "$ref": "#/$defs/nullableToken"
    },
    "total_tokens": {
      "$ref": "#/$defs/nullableToken"
    },
    "started_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "wall_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "source_artifact_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "usage_stage": {
            "const": "acceptance_live_smoke"
          }
        },
        "required": [
          "usage_stage"
        ]
      },
      "then": {
        "properties": {
          "implementation_run_id": {
            "$ref": "#/$defs/identifier"
          },
          "gate_epoch": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "else": {
        "properties": {
          "implementation_run_id": {
            "type": "null"
          },
          "gate_epoch": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage_status": {
            "const": "reported"
          }
        },
        "required": [
          "usage_status"
        ]
      },
      "then": {
        "properties": {
          "unavailable_reason": {
            "type": "null"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "total_tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage_status": {
            "enum": [
              "partial",
              "unavailable"
            ]
          }
        },
        "required": [
          "usage_status"
        ]
      },
      "then": {
        "properties": {
          "unavailable_reason": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "usage_status": {
            "const": "not_applicable"
          }
        },
        "required": [
          "usage_status"
        ]
      },
      "then": {
        "properties": {
          "coverage_class": {
            "const": "not_applicable_adapter"
          },
          "accounting_method": {
            "const": "not_applicable"
          },
          "provider_usage_scope": {
            "const": "unknown"
          },
          "provider_usage_snapshot": {
            "type": "null"
          },
          "unavailable_reason": {
            "type": "null"
          },
          "input_tokens": {
            "type": "null"
          },
          "cached_input_tokens": {
            "type": "null"
          },
          "output_tokens": {
            "type": "null"
          },
          "reasoning_tokens": {
            "type": "null"
          },
          "total_tokens": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_class": {
            "const": "supported_model_invocation"
          }
        },
        "required": [
          "coverage_class"
        ]
      },
      "then": {
        "not": {
          "properties": {
            "usage_status": {
              "const": "not_applicable"
            }
          },
          "required": [
            "usage_status"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "coverage_class": {
            "const": "not_applicable_adapter"
          }
        },
        "required": [
          "coverage_class"
        ]
      },
      "then": {
        "properties": {
          "usage_status": {
            "const": "not_applicable"
          },
          "accounting_method": {
            "const": "not_applicable"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting_method": {
            "const": "provider_reported"
          }
        },
        "required": [
          "accounting_method"
        ]
      },
      "then": {
        "properties": {
          "provider_usage_scope": {
            "const": "invocation"
          },
          "provider_usage_snapshot": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting_method": {
            "const": "session_delta"
          }
        },
        "required": [
          "accounting_method"
        ]
      },
      "then": {
        "properties": {
          "usage_status": {
            "const": "reported"
          },
          "provider_usage_scope": {
            "const": "session_cumulative"
          },
          "provider_usage_snapshot": {
            "$ref": "#/$defs/tokenSnapshot"
          },
          "provider_session_id": {
            "$ref": "#/$defs/identifier"
          },
          "provider_predecessor_invocation_id": {
            "$ref": "#/$defs/invocationId"
          },
          "provider_turn_id": {
            "$ref": "#/$defs/identifier"
          },
          "provider_predecessor_turn_id": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accounting_method": {
            "const": "unavailable"
          }
        },
        "required": [
          "accounting_method"
        ]
      },
      "then": {
        "properties": {
          "usage_status": {
            "enum": [
              "partial",
              "unavailable"
            ]
          },
          "input_tokens": {
            "type": "null"
          },
          "cached_input_tokens": {
            "type": "null"
          },
          "output_tokens": {
            "type": "null"
          },
          "reasoning_tokens": {
            "type": "null"
          },
          "total_tokens": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider_usage_scope": {
            "const": "session_cumulative"
          }
        },
        "required": [
          "provider_usage_scope"
        ]
      },
      "then": {
        "properties": {
          "provider_usage_snapshot": {
            "$ref": "#/$defs/tokenSnapshot"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "nullableIdentifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "invocationId": {
      "type": "string",
      "pattern": "^INV-[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableToken": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "usageStage": {
      "enum": [
        "single_codex",
        "taskpack_author",
        "planner_or_task_slicer",
        "repo_map",
        "implementation_worker",
        "review_or_repair",
        "follow_up_author",
        "semantic_architecture",
        "runtime_diagnostic",
        "development_smoke",
        "acceptance_live_smoke"
      ]
    },
    "tokenSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/nullableToken"
        },
        "cached_input_tokens": {
          "$ref": "#/$defs/nullableToken"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullableToken"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/nullableToken"
        },
        "total_tokens": {
          "$ref": "#/$defs/nullableToken"
        }
      }
    }
  }
}
