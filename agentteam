#!/usr/bin/env python3
"""Small pre-import launcher for immutable AgentTeam runtime releases."""

import hashlib
import json
import os
import re
import sys
from pathlib import Path


SELECTION_ENV = "AGENTTEAM_LAUNCHER_SELECTION"
RUN_NAMESPACE_PATTERN = re.compile(r"^v[1-9][0-9]*$")
RESUMING_COMMANDS = {
    "continue",
    "resume",
    "answer",
    "permissions",
    "integrate",
    "gate",
    "notify",
}
RUN_SELECTING_COMMANDS = RESUMING_COMMANDS | {
    "status",
    "report",
    "watch",
    "chat",
    "doctor",
    "logs",
    "explain-status",
    "paths",
    "stop",
    "stats",
}


class LauncherError(RuntimeError):
    pass


def main():
    try:
        selection = _launcher_selection(sys.argv[1:])
        if selection:
            runtime_root = Path(selection["release"]["runtime_root"])
            os.environ[SELECTION_ENV] = _canonical_json(selection)
        else:
            os.environ.pop(SELECTION_ENV, None)
            runtime_root = _active_release_runtime_root(sys.argv[1:]) or _development_runtime_root()
        sys.path.insert(0, str(runtime_root))
        from agentteam_runtime.agentteam import main as agentteam_main

        return agentteam_main()
    except Exception as exc:
        sys.stderr.write(
            json.dumps(
                {
                    "error": {
                        "type": exc.__class__.__name__,
                        "message": str(exc),
                        "launcher_phase": "runtime_release_selection",
                    }
                },
                sort_keys=True,
            )
            + "\n"
        )
        return 1


def _launcher_selection(argv):
    if "-h" in argv or "--help" in argv:
        return None
    command = _command(argv)
    if command == "doctor" and "--invocation-supervision-probe" in argv:
        return None
    if command == "run":
        return _initial_run_selection(argv)
    if command in RUN_SELECTING_COMMANDS:
        return _existing_run_selection(argv, command)
    project = _project_context(argv)
    if not project and command == "submit" and _arg_value(argv, "--work-root"):
        work_root = Path(_arg_value(argv, "--work-root")).expanduser().resolve()
        project_root = _project_root_from_argv(argv)
        project = {
            "work_root": work_root,
            "project_key": _safe_project_key(project_root, fallback=work_root.name),
        }
    if project and (project["work_root"] / "releases" / "active.json").is_file():
        return {
            "selection_version": "launcher_runtime_selection.v1",
            "selection_mode": "active_for_new_run",
            "work_root": str(project["work_root"]),
            "project_key": project["project_key"],
            "run_dir": None,
            "identity_sha256": None,
            "release": _active_release(project["work_root"]),
            "expected_release": {},
        }
    return None


def _initial_run_selection(argv):
    frozen_value = _positional_after_command(argv, "run")
    run_root_value = _arg_value(argv, "--run-root")
    if not frozen_value or not run_root_value:
        return None
    frozen = Path(frozen_value).expanduser().resolve()
    taskpack = _bounded_json(frozen / "taskpack.yaml", "frozen taskpack")
    taskpack_id = taskpack.get("taskpack_id") or frozen.name
    supplied_run_root = Path(run_root_value).expanduser().resolve()
    run_root = supplied_run_root.parent if supplied_run_root.name == taskpack_id else supplied_run_root
    run_dir = (run_root / taskpack_id).resolve()
    frozen_work_root = _work_root_for_namespace(
        frozen.parent,
        "frozen",
    )
    run_work_root = _work_root_for_namespace(run_root, "runs")
    context = taskpack.get("context") if isinstance(taskpack.get("context"), dict) else {}
    expected = {
        key: value
        for key, value in {
            "release_id": context.get("runtime_release_id"),
            "source_commit": context.get("runtime_release_source_commit"),
            "git_object_format": context.get("git_object_format"),
        }.items()
        if value is not None
    }
    if expected and (not frozen_work_root or not run_work_root or frozen_work_root != run_work_root):
        raise LauncherError(
            "approval-bound frozen taskpack and --run-root do not resolve to the same work root"
        )
    work_root = frozen_work_root or run_work_root or run_root.parent.resolve()
    if frozen_work_root and run_work_root and frozen_work_root == run_work_root:
        frozen_namespace = _artifact_version_namespace(
            frozen,
            work_root,
            "frozen",
            taskpack_id,
        )
        run_namespace = _artifact_version_namespace(
            run_dir,
            work_root,
            "runs",
            taskpack_id,
        )
        if frozen_namespace != run_namespace:
            raise LauncherError(
                "frozen taskpack and run directory use different version namespaces"
            )
    profile = _profile_from_project_root(taskpack.get("project_root"))
    project_key = (
        profile.get("project_key")
        if profile and Path(profile["work_root"]).resolve() == work_root
        else None
    ) or _safe_project_key(taskpack.get("project_root"), fallback=work_root.name)
    release = (
        _release_by_id(work_root, expected["release_id"], expected)
        if expected.get("release_id")
        else _active_release(work_root)
    )
    return {
        "selection_version": "launcher_runtime_selection.v1",
        "selection_mode": "initial_frozen_taskpack",
        "work_root": str(work_root),
        "project_key": project_key,
        "run_dir": str(run_dir),
        "frozen_taskpack_dir": str(frozen),
        "identity_sha256": None,
        "release": release,
        "expected_release": expected,
    }


def _work_root_for_namespace(path, namespace):
    current = Path(path).resolve()
    while current != current.parent:
        if current.name == namespace:
            return current.parent.resolve()
        current = current.parent
    return None


def _artifact_version_namespace(path, work_root, namespace, leaf_id):
    path = Path(path).resolve()
    namespace_root = Path(work_root).resolve() / namespace
    try:
        relative = path.relative_to(namespace_root)
    except ValueError as exc:
        raise LauncherError(
            f"{namespace} artifact is outside the selected work root"
        ) from exc
    if relative.parts == (leaf_id,):
        return None
    if (
        len(relative.parts) == 2
        and RUN_NAMESPACE_PATTERN.fullmatch(relative.parts[0])
        and relative.parts[1] == leaf_id
    ):
        if namespace == "runs":
            direct_identity = (
                namespace_root
                / relative.parts[0]
                / "state"
                / "run_identity.v1.json"
            )
            if direct_identity.exists() or direct_identity.is_symlink():
                raise LauncherError(
                    "versioned run namespace conflicts with a direct vN run"
                )
        return relative.parts[0]
    raise LauncherError(f"{namespace} artifact has an unsupported namespace")


def _existing_run_selection(argv, command):
    project = _project_context(argv)
    explicit_run = _arg_value(argv, "--run-dir")
    explicit_taskpack = _arg_value(argv, "--taskpack")
    if not project and explicit_run:
        run_dir = Path(explicit_run).expanduser().resolve()
        project = {
            "work_root": (
                _work_root_for_namespace(run_dir.parent, "runs")
                or run_dir.parent.parent.resolve()
            ),
            "project_key": None,
        }
    if not project:
        return None
    work_root = project["work_root"]
    pair = None
    if explicit_run:
        run_dir = Path(explicit_run).expanduser().resolve()
        mode = "explicit_run_dir"
    elif explicit_taskpack:
        try:
            pair = _latest_bound_run(
                work_root,
                project["project_key"],
                taskpack_id=explicit_taskpack,
            )
        except LauncherError:
            if command not in RESUMING_COMMANDS:
                return None
            raise
        run_dir = Path(pair["run_dir"])
        mode = "explicit_taskpack"
    else:
        run_root = work_root / "runs"
        if not run_root.is_dir() or not any(
            child.is_dir() or child.is_symlink() for child in run_root.iterdir()
        ):
            return None
        pair = _latest_bound_run(work_root, project["project_key"])
        run_dir = Path(pair["run_dir"])
        mode = "implicit_latest"
    try:
        if pair is None:
            pair = _validate_run_pair(run_dir, project["project_key"])
    except LauncherError:
        if command not in RESUMING_COMMANDS and (explicit_run or explicit_taskpack):
            return None  # explicit legacy runs remain readable, never implicitly adopted
        raise
    return {
        "selection_version": "launcher_runtime_selection.v1",
        "selection_mode": mode,
        "work_root": str(work_root),
        "project_key": project["project_key"],
        "run_dir": pair["run_dir"],
        "frozen_taskpack_dir": _frozen_taskpack_dir_for_pair(work_root, pair),
        "identity_sha256": pair["identity_sha256"],
        "release": pair["release"],
        "expected_release": pair["binding"].get("expected_release") or {},
    }


def _latest_bound_run(work_root, project_key, taskpack_id=None):
    run_root = Path(work_root) / "runs"
    if not run_root.is_dir():
        raise LauncherError("no AgentTeam runs found")
    implementations = []
    sequences = {}
    for child in _iter_run_identity_directories(run_root):
        state_dir = child / "state"
        if state_dir.is_symlink():
            raise LauncherError(f"symlink run state blocks implicit selection: {child.name}")
        identity_path = state_dir / "run_identity.v1.json"
        if identity_path.is_symlink() or not identity_path.is_file():
            raise LauncherError(
                f"run child lacks an immutable identity and blocks implicit selection: {child.name}"
            )
        identity = _bounded_json(identity_path, "run identity")
        _validate_identity(identity, child.name, project_key)
        if identity["run_kind"] == "acceptance_evidence":
            if (child / "state" / "runtime_release_binding.v1.json").exists():
                raise LauncherError("acceptance evidence run must not have a release binding")
            continue
        if taskpack_id is not None and identity["taskpack_id"] != taskpack_id:
            continue
        pair = _validate_run_pair(child, project_key)
        sequence = identity["creation_sequence"]
        if sequence in sequences:
            raise LauncherError(f"duplicate implementation creation_sequence: {sequence}")
        sequences[sequence] = child.name
        implementations.append(pair)
    if not implementations:
        detail = f" for taskpack {taskpack_id}" if taskpack_id else ""
        raise LauncherError(f"no bound implementation runs found{detail}")
    return max(implementations, key=lambda item: item["identity"]["creation_sequence"])


def _iter_run_identity_directories(run_root):
    for child in sorted(Path(run_root).iterdir(), key=lambda path: path.name):
        if child.is_symlink() or not child.is_dir():
            raise LauncherError(
                f"unsafe run child blocks implicit selection: {child.name}"
            )
        identity_path = child / "state" / "run_identity.v1.json"
        if identity_path.exists() or identity_path.is_symlink():
            if identity_path.is_symlink() or not identity_path.is_file():
                raise LauncherError(
                    f"unsafe direct run identity blocks scan: {child.name}"
                )
            yield child
            continue
        if not RUN_NAMESPACE_PATTERN.fullmatch(child.name):
            yield child
            continue
        for nested in sorted(child.iterdir(), key=lambda path: path.name):
            if nested.is_symlink() or not nested.is_dir():
                raise LauncherError(
                    "unsafe versioned run child blocks implicit selection: "
                    f"{child.name}/{nested.name}"
                )
            yield nested


def _frozen_taskpack_dir_for_pair(work_root, pair):
    work_root = Path(work_root).resolve()
    run_dir = Path(pair["run_dir"]).resolve()
    try:
        relative = run_dir.relative_to(work_root / "runs")
    except ValueError as exc:
        raise LauncherError("selected run is outside the project run namespace") from exc
    if len(relative.parts) == 1:
        namespace = ()
    elif len(relative.parts) == 2 and RUN_NAMESPACE_PATTERN.fullmatch(
        relative.parts[0]
    ):
        namespace = (relative.parts[0],)
    else:
        raise LauncherError("selected run has an unsupported namespace")
    return str(
        work_root
        / "frozen"
        / Path(*namespace)
        / pair["identity"]["taskpack_id"]
    )


def _validate_run_pair(run_dir, project_key):
    run_dir = Path(run_dir)
    if run_dir.is_symlink() or not run_dir.is_dir():
        raise LauncherError(f"run directory is missing or unsafe: {run_dir}")
    run_dir = run_dir.resolve()
    state_dir = run_dir / "state"
    if state_dir.is_symlink() or not state_dir.is_dir():
        raise LauncherError("selected run state directory is missing or unsafe")
    identity_path = state_dir / "run_identity.v1.json"
    binding_path = state_dir / "runtime_release_binding.v1.json"
    if identity_path.is_symlink() or not identity_path.is_file():
        raise LauncherError("selected run has no immutable identity")
    if binding_path.is_symlink() or not binding_path.is_file():
        raise LauncherError("selected implementation run has no immutable release binding")
    identity = _bounded_json(identity_path, "run identity")
    binding = _bounded_json(binding_path, "runtime release binding")
    _validate_identity(identity, run_dir.name, project_key)
    if identity["run_kind"] != "implementation":
        raise LauncherError("selected run is not an implementation run")
    release = _validate_bound_release(binding)
    return {
        "run_dir": str(run_dir),
        "identity": identity,
        "identity_sha256": _sha256_canonical(identity),
        "binding": binding,
        "release": release,
    }


def _validate_identity(identity, directory_name, project_key):
    if identity.get("schema_version") != "run_identity.v1":
        raise LauncherError("invalid run identity schema")
    common = {
        "schema_version",
        "project_key",
        "run_id",
        "taskpack_id",
        "run_kind",
        "created_at",
    }
    for key in ("project_key", "run_id", "taskpack_id"):
        value = identity.get(key)
        if not isinstance(value, str) or not re.fullmatch(
            r"[A-Za-z0-9][A-Za-z0-9_.-]*", value
        ):
            raise LauncherError(f"run identity {key} is invalid")
    if not isinstance(identity.get("created_at"), str) or not identity["created_at"]:
        raise LauncherError("run identity created_at is invalid")
    if identity.get("run_id") != directory_name:
        raise LauncherError("run identity does not match directory name")
    if project_key and identity.get("project_key") != project_key:
        raise LauncherError("run identity belongs to a different project")
    if identity.get("run_kind") == "implementation":
        allowed = common | {"creation_sequence", "implementation_run_id"}
        if set(identity) - allowed:
            raise LauncherError("implementation run identity has unknown fields")
        sequence = identity.get("creation_sequence")
        if not isinstance(sequence, int) or isinstance(sequence, bool) or sequence <= 0:
            raise LauncherError("implementation creation_sequence must be positive")
        parent_run_id = identity.get("implementation_run_id")
        if parent_run_id is not None and (
            not isinstance(parent_run_id, str)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]*", parent_run_id)
        ):
            raise LauncherError("implementation parent run ID is invalid")
    elif identity.get("run_kind") == "acceptance_evidence":
        allowed = common | {"implementation_run_id", "gate_epoch"}
        if set(identity) - allowed:
            raise LauncherError("acceptance evidence identity has unknown fields")
        if identity.get("creation_sequence") is not None:
            raise LauncherError("acceptance evidence must not have a creation_sequence")
        if not isinstance(identity.get("implementation_run_id"), str) or not re.fullmatch(
            r"[A-Za-z0-9][A-Za-z0-9_.-]*", identity["implementation_run_id"]
        ):
            raise LauncherError("acceptance evidence requires implementation_run_id")
        epoch = identity.get("gate_epoch")
        if not isinstance(epoch, int) or isinstance(epoch, bool) or epoch <= 0:
            raise LauncherError("acceptance evidence requires a positive gate_epoch")
    else:
        raise LauncherError("invalid run_kind")


def _validate_bound_release(binding):
    if binding.get("schema_version") != "runtime_release_binding.v1":
        raise LauncherError("invalid runtime release binding schema")
    required = {
        "schema_version",
        "release_id",
        "release_root",
        "runtime_root",
        "release_manifest_sha256",
        "source_commit",
        "git_object_format",
        "bound_at",
        "approval_bound",
        "expected_release",
    }
    if set(binding) != required:
        raise LauncherError("runtime release binding fields do not match the schema")
    if not isinstance(binding.get("release_id"), str) or not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9_.-]*", binding["release_id"]
    ):
        raise LauncherError("bound release ID is invalid")
    if not isinstance(binding.get("bound_at"), str) or not binding["bound_at"]:
        raise LauncherError("runtime release binding timestamp is invalid")
    if not isinstance(binding.get("approval_bound"), bool):
        raise LauncherError("runtime release binding approval flag is invalid")
    expected = binding.get("expected_release")
    if not isinstance(expected, dict) or set(expected) - {
        "release_id",
        "source_commit",
        "git_object_format",
    }:
        raise LauncherError("runtime release expected fields are invalid")
    if binding["approval_bound"] and set(expected) != {
        "release_id",
        "source_commit",
        "git_object_format",
    }:
        raise LauncherError("approval-bound release expectation is incomplete")
    if not binding["approval_bound"] and expected:
        raise LauncherError("unapproved release binding must not contain expected fields")
    if not isinstance(binding.get("release_manifest_sha256"), str) or not re.fullmatch(
        r"[0-9a-f]{64}", binding["release_manifest_sha256"]
    ):
        raise LauncherError("bound release manifest digest is invalid")
    object_format = binding.get("git_object_format")
    oid_length = 40 if object_format == "sha1" else 64 if object_format == "sha256" else 0
    if not oid_length or not isinstance(binding.get("source_commit"), str) or not re.fullmatch(
        rf"[0-9a-f]{{{oid_length}}}", binding["source_commit"]
    ):
        raise LauncherError("bound release source commit is invalid")
    for key in ("release_id", "source_commit", "git_object_format"):
        if expected.get(key) is not None and expected[key] != binding[key]:
            raise LauncherError(f"bound release {key} does not match frozen approval")
    release_root = Path(str(binding.get("release_root") or "")).expanduser().resolve()
    manifest_path = release_root / "manifest.json"
    if manifest_path.is_symlink() or not manifest_path.is_file():
        raise LauncherError("bound release manifest is missing")
    digest = hashlib.sha256(manifest_path.read_bytes()).hexdigest()
    if digest != binding.get("release_manifest_sha256"):
        raise LauncherError("bound release manifest digest mismatch")
    manifest = _bounded_json(manifest_path, "release manifest")
    runtime_root = Path(
        manifest.get("runtime_root")
        or release_root / "experiments" / "native_agentteam_runtime" / "m0_runtime"
    ).expanduser().resolve()
    source_commit = manifest.get("source_commit") or manifest.get("source_git_commit")
    if manifest.get("release_id") != binding.get("release_id"):
        raise LauncherError("bound release ID does not match manifest")
    if source_commit != binding.get("source_commit"):
        raise LauncherError("bound release source commit does not match manifest")
    if runtime_root != Path(str(binding.get("runtime_root") or "")).expanduser().resolve():
        raise LauncherError("bound runtime root does not match manifest")
    if not (runtime_root / "agentteam_runtime" / "agentteam.py").is_file():
        raise LauncherError("bound runtime module is missing")
    return {
        key: binding[key]
        for key in (
            "release_id",
            "release_root",
            "runtime_root",
            "release_manifest_sha256",
            "source_commit",
            "git_object_format",
        )
    }


def _active_release(work_root):
    active = _bounded_json(Path(work_root) / "releases" / "active.json", "active release")
    release_id = active.get("release_id")
    if not release_id:
        raise LauncherError("active release pointer has no release_id")
    release = _release_by_id(work_root, release_id, {})
    if active.get("release_root") and (
        Path(active["release_root"]).expanduser().resolve() != Path(release["release_root"])
    ):
        raise LauncherError("active release root does not match release manifest")
    return release


def _release_by_id(work_root, release_id, expected):
    refs_manifest = Path(work_root) / "releases" / "refs" / f"{release_id}.json"
    local_manifest = Path(work_root) / "releases" / release_id / "manifest.json"
    lookup = refs_manifest if refs_manifest.is_file() else local_manifest
    manifest = _bounded_json(lookup, "project release manifest")
    release_root = Path(
        manifest.get("release_root") or local_manifest.parent
    ).expanduser().resolve()
    root_manifest_path = release_root / "manifest.json"
    root_manifest = _bounded_json(root_manifest_path, "release manifest")
    if root_manifest.get("release_id") != release_id:
        raise LauncherError("release manifest ID mismatch")
    runtime_root = Path(
        root_manifest.get("runtime_root")
        or release_root / "experiments" / "native_agentteam_runtime" / "m0_runtime"
    ).expanduser().resolve()
    source_commit = root_manifest.get("source_commit") or root_manifest.get("source_git_commit")
    object_format = root_manifest.get("git_object_format") or (
        "sha1" if isinstance(source_commit, str) and len(source_commit) == 40
        else "sha256" if isinstance(source_commit, str) and len(source_commit) == 64
        else None
    )
    release = {
        "release_id": release_id,
        "release_root": str(release_root),
        "runtime_root": str(runtime_root),
        "release_manifest_sha256": hashlib.sha256(root_manifest_path.read_bytes()).hexdigest(),
        "source_commit": source_commit,
        "git_object_format": object_format,
    }
    if not (runtime_root / "agentteam_runtime" / "agentteam.py").is_file():
        raise LauncherError("selected release runtime module is missing")
    for key in ("release_id", "source_commit", "git_object_format"):
        if expected.get(key) is not None and release.get(key) != expected[key]:
            raise LauncherError(f"selected release {key} does not match frozen approval")
    if object_format not in {"sha1", "sha256"}:
        raise LauncherError("selected release Git object format is invalid")
    oid_length = 40 if object_format == "sha1" else 64
    if not isinstance(source_commit, str) or not re.fullmatch(rf"[0-9a-f]{{{oid_length}}}", source_commit):
        raise LauncherError("selected release source commit is invalid")
    return release


def _project_context(argv):
    project_root = _project_root_from_argv(argv)
    profile = _profile_from_project_root(project_root)
    if not profile:
        return None
    return {
        "project_root": Path(project_root).resolve(),
        "project_key": profile.get("project_key") or Path(project_root).resolve().name,
        "work_root": Path(profile["work_root"]).expanduser().resolve(),
    }


def _profile_from_project_root(project_root):
    if not project_root:
        return None
    profile_path = Path(project_root).expanduser().resolve() / ".agentteam" / "profile.json"
    if not profile_path.is_file():
        return None
    profile = _bounded_json(profile_path, "project profile")
    if not profile.get("work_root"):
        raise LauncherError("project profile is missing work_root")
    return profile


def _active_release_runtime_root(argv):
    project = _project_context(argv)
    if not project:
        return None
    active_path = project["work_root"] / "releases" / "active.json"
    if not active_path.is_file():
        return None
    try:
        return Path(_active_release(project["work_root"])["runtime_root"])
    except LauncherError:
        active = _bounded_json(active_path, "active release")
        release_root = active.get("release_root")
        if not release_root:
            raise
        runtime_root = (
            Path(release_root).expanduser().resolve()
            / "experiments"
            / "native_agentteam_runtime"
            / "m0_runtime"
        )
        if not (runtime_root / "agentteam_runtime" / "agentteam.py").is_file():
            raise
        return runtime_root


def _project_root_from_argv(argv):
    value = _arg_value(argv, "--project-root")
    return Path(value).resolve() if value else Path.cwd().resolve()


def _command(argv):
    return argv[0] if argv else None


def _arg_value(argv, flag):
    for index, arg in enumerate(argv):
        if arg == flag and index + 1 < len(argv):
            return argv[index + 1]
        if arg.startswith(flag + "="):
            return arg.split("=", 1)[1]
    return None


def _positional_after_command(argv, command):
    try:
        index = argv.index(command) + 1
    except ValueError:
        return None
    while index < len(argv):
        value = argv[index]
        if value.startswith("-"):
            index += 2 if "=" not in value else 1
            continue
        return value
    return None


def _bounded_json(path, label, limit=1024 * 1024):
    path = Path(path)
    if path.is_symlink() or not path.is_file():
        raise LauncherError(f"{label} is missing or unsafe: {path}")
    if path.stat().st_size > limit:
        raise LauncherError(f"{label} exceeds bounded launcher read limit")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise LauncherError(f"{label} is not valid JSON") from exc
    if not isinstance(value, dict):
        raise LauncherError(f"{label} must be a JSON object")
    return value


def _canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)


def _sha256_canonical(value):
    return hashlib.sha256(_canonical_json(value).encode("utf-8")).hexdigest()


def _safe_project_key(project_root, fallback):
    name = Path(project_root).name if project_root else fallback
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "-", str(name)).strip(".-")
    return safe or "agentteam"


def _development_runtime_root():
    configured = _configured_development_repo_root()
    if configured:
        return configured / "experiments" / "native_agentteam_runtime" / "m0_runtime"
    repo_root = Path(__file__).resolve().parent
    return repo_root / "experiments" / "native_agentteam_runtime" / "m0_runtime"


def _configured_development_repo_root():
    env_root = os.environ.get("AGENTTEAM_DEV_ROOT")
    if env_root:
        return Path(env_root).resolve()
    config_path = Path.home() / ".local" / "share" / "agentteam" / "launcher.json"
    if not config_path.exists():
        return None
    try:
        config = json.loads(config_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    repo_root = config.get("development_repo_root")
    return Path(repo_root).resolve() if repo_root else None


